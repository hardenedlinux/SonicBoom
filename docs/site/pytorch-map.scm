   ;; --- recipes ---
   (torch "torch.sigmoid"
     (status recipe)
     (recipe "(ctensor->list (div 1.0 (add 1.0 (texp (neg x)))))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.nn.functional.silu"
     (status recipe)
     (recipe "(ctensor->list (mul x (div 1.0 (add 1.0 (texp (neg x))))))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.abs"
     (status recipe)
     (recipe "(ctensor->list (where (lt x 0.0) (neg x) x))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.reciprocal"
     (status recipe)
     (recipe "(ctensor->list (div 1.0 x))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.square"
     (status recipe)
     (recipe "(ctensor->list (mul x x))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.ne"
     (status recipe)
     (recipe "(ctensor->list (logical-not (equal-to a b)))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define a (list->ctensor '(1.0 2.0)))\n(define b (list->ctensor '(2.0 2.0)))"))
   (torch "torch.logical_xor"
     (status recipe)
     (recipe "(ctensor->list (logical-not (equal-to a b)))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define a (equal-to (list->ctensor '(1.0 0.0)) 1.0))\n(define b (equal-to (list->ctensor '(0.0 2.0)) 2.0))")
     (note "Takes boolean tensors."))
   (torch "torch.maximum"
     (status recipe)
     (recipe "(ctensor->list (where (gt a b) a b))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define a (list->ctensor '(1.0 2.0)))\n(define b (list->ctensor '(2.0 2.0)))"))
   (torch "torch.minimum"
     (status recipe)
     (recipe "(ctensor->list (where (lt a b) a b))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define a (list->ctensor '(1.0 2.0)))\n(define b (list->ctensor '(2.0 2.0)))"))
   (torch "torch.nn.functional.relu6"
     (status recipe)
     (recipe "(ctensor->list (where (lt x 0.0) 0.0 (where (gt x 6.0) 6.0 x)))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))"))
   (torch "torch.nn.functional.hardtanh"
     (status recipe)
     (recipe "(ctensor->list (where (lt x -1.0) -1.0 (where (gt x 1.0) 1.0 x)))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))")
     (note "The default bounds -1 and 1."))
   (torch "torch.nn.functional.leaky_relu"
     (status recipe)
     (recipe "(ctensor->list (where (lt x 0.0) (mul 0.01 x) x))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))")
     (note "The default negative slope 0.01."))
   (torch "torch.flatten"
     (status recipe)
     (recipe "(ctensor->list (reshape x (list (ctensor-numel x))))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))")
     (note "A contiguous tensor becomes one dimension."))
   (torch "torch.clamp"
     (status recipe)
     (recipe "(ctensor->list (where (lt x -0.5) -0.5 (where (gt x 0.5) 0.5 x)))")
     (setup "(use-modules (sonicboom trace tensor) (sonicboom trace symbolic))\n(define x (list->ctensor '(0.5 -1.0 2.0)))")
     (note "The bounds are passed explicitly."))

