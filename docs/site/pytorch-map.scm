;;; The mapping from PyTorch names to SonicBoom.
;;;
;;; Each entry is one of:
;;;
;;;   (torch NAME (aliases ...) (status supported)
;;;     (use ((module) symbol) ...) (note "..."))
;;;   (torch NAME (status recipe) (recipe "...") (setup "...") (note "..."))
;;;   (torch NAME (same-as NAME))
;;;   (prefix "torch.foo." (status missing|out-of-scope) (note "..."))
;;;
;;; Every name in pytorch-names.tsv resolves to an entry of its own, a
;;; same-as entry, or the longest prefix entry.  A prefix is only used for
;;; a subtree with no entry of its own.
;;;
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Copyright (C) 2026 Nala Ginrut <roy@hardenedlinux.org>

(define pytorch-map
  '(
   ;; --- supported ---
   (torch "torch.save"
     (status supported)
     (use ((sonicboom checkpoint) save-params!))
     (note "The checkpoint format is the binding's own; files are not interchangeable with PyTorch checkpoints."))
   (torch "torch.load"
     (status supported)
     (use ((sonicboom checkpoint) load-params!))
     (note "The checkpoint format is the binding's own; files are not interchangeable with PyTorch checkpoints."))
