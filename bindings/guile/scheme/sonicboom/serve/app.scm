#! /usr/bin/env guile
!#
;;; SonicBoom — inference service: the OpenAI-compatible HTTP app (Artanis)
;;;
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Copyright (C) 2026 Nala Ginrut <roy@hardenedlinux.org>
;;;
;;; A single-file GNU Artanis app, written like examples/test.scm and
;;; examples/ENTRY.websocket of Artanis: (init-server), routes with get/post,
;;; #:mime 'json with :mime for JSON, response-emit for other statuses,
;;; #:websocket 'raw with ws-send for WebSocket, call-with-runner for the
;;; blocking work, then (run). It is a script, not a module:
;;;
;;;   guile -L bindings/guile/scheme \
;;;         bindings/guile/scheme/sonicboom/serve/app.scm --port 8000
;;;
;;; Only the HTTP layer is here. The backend protocol, the mock backend, the
;;; session pool, the queue and the OpenAI format are the modules next to
;;; this file; they don't depend on Artanis, except (sonicboom serve sse).
;;;
;;; Endpoints
;;;   GET  /v1/models, /v1/models/:id  chat models; loaded says which one is
;;;                                   on the device
;;;   POST /v1/chat/completions       stream=false: JSON; stream=true: SSE
;;;   POST /v1/images/generations     MOSS-Image, PNG as base64 (b64_json);
;;;                                   stream=true: SSE progress; the response
;;;                                   header sonicboom-job-id names the job
;;;   DELETE /sonicboom/jobs/:id      cancel a generation by job id
;;;   GET  /v1/ws/chat                WebSocket: a request per text message,
;;;                                   answered by chunk JSON messages, "[DONE]"
;;;   GET  /sonicboom/models          every served model and its residency
;;;   POST /sonicboom/models/:id/load, .../unload   queued device switches
;;;   GET  /sonicboom/styles          the style assets (card + steering vector)
;;;   POST /sonicboom/styles          create one (queued: it may measure vectors)
;;;   DELETE /sonicboom/styles/:id    forget one
;;;   GET  /sonicboom/stats           queue, sessions and backend counters
;;;   POST /sonicboom/replay/:id      regenerate a stored reply exactly
;;;   GET  /sonicboom/history         the replay store as a minimal HTML page
;;;   GET  /health
;;;
;;; One model is on the device at a time. Chat requests, images, loads and
;;; unloads share one FIFO queue; the job at the front makes its model the
;;; resident one (unloading the previous model) before it runs.
;;;
;;; Options
;;;   --host ADDR --port N            listen address (127.0.0.1:8000)
;;;   --backend real|mock             libsonicboom C ABI (real) or the
;;;                                   deterministic in-process mock (real)
;;;   --model FILE --model-id ID      the real backend's GGUF and served id
;;;                                   (models/qwen2.5-7b-instruct-1m-q4_k_m.gguf,
;;;                                   qwen2.5-7b)
;;;   --image-model DIR               MOSS-Image root, served as the
;;;                                   "moss-image" model and switched to on
;;;                                   an image request (models/MOSS-Image-SFT)
;;;   --queue N                       requests allowed to wait (8)
;;;   --max-sessions N --token-budget N   session pool, per model (1 for the
;;;                                   real backend, 4 for the mock; 32768)
;;;   --context-length N              of the loaded model (16384 real, 8192
;;;                                   mock)
;;;   --step-delay S --prefill-delay S    simulated device time, seconds
;;;   --request-log PATH              append one JSON line per request
;;;                                   (id, model, kind, start/end, status,
;;;                                   token counts, queue/switch ms, device
;;;                                   memory; never a request body)
;;;   --runtime-dir DIR               Artanis' working directory
;;;                                   ($TMPDIR/sonicboom-serve-<pid>)
;;;   --replay-store DIR              keep request bodies locally so a reply
;;;                                   can be regenerated by id (off by default)

(use-modules (artanis artanis)
             ((artanis config) #:select (conf-set!))
             ((artanis env) #:select (%current-toplevel))
             ((artanis route) #:select (rc-method rc-path))
             (rnrs bytevectors)
             (ice-9 textual-ports)
             (srfi srfi-1)
             (srfi srfi-9)
             (srfi srfi-13)
             (ice-9 ftw)
             (ice-9 getopt-long)
             (ice-9 threads)
             (ice-9 binary-ports)
             (ice-9 match)
             (sonicboom error)
             (sonicboom image)
             ((sonicboom inference) #:select (device-trim!))
             (sonicboom serve backend)
             (sonicboom serve real-backend)
             (sonicboom serve mock-backend)
             (sonicboom serve engine)
             (sonicboom serve residency)
             (sonicboom serve sessions)
             (sonicboom serve styles)
             (sonicboom serve chat-template)
             (sonicboom serve fingerprint)
             (sonicboom serve openai)
             (sonicboom serve sse))

;;; ---------------------------------------------------------------------------
;;; Options

(define options
  (getopt-long (command-line)
               '((host (value #t)) (port (value #t)) (backend (value #t))
                 (model (value #t)) (model-id (value #t)) (queue (value #t))
                 (max-sessions (value #t)) (token-budget (value #t))
                 (context-length (value #t)) (step-delay (value #t))
                 (prefill-delay (value #t)) (image-model (value #t))
                 (request-log (value #t))
                 (replay-store (value #t))
                 (runtime-dir (value #t)))))

(define (option key default)
  (match (option-ref options key #f)
    (#f default)
    (s (if (number? default) (string->number s) s))))

(define queue-limit (option 'queue 8))

;; Artanis looks for its working directory (sys/i18n, ...) from the toplevel
;; of an `art create' project; a single-file app has none, so give it one.
(define runtime-dir
  (option 'runtime-dir
          (format #f "~a/sonicboom-serve-~a" (or (getenv "TMPDIR") "/tmp") (getpid))))
(system* "mkdir" "-p" (string-append runtime-dir "/sys/i18n"))
(%current-toplevel runtime-dir)

(init-server #:statics '())
;; The job-cancel route is DELETE; Artanis' default leaves that method out.
(conf-set! '(server allowedmethods) '(HEAD GET POST PUT DELETE))
(conf-set! '(server websocket) #t)
;; Generation runs in runner threads; waiting requests hold one each.
(conf-set! '(server runners) (+ queue-limit 2))
(sse-install!)

;;; ---------------------------------------------------------------------------
;;; The catalog and the engine: one real Gemma 4 model loaded through
;;; libsonicboom's C ABI, or (--backend mock) the deterministic in-process mock
;;; — one model per chat template family, no GGUF needed. Both go through the
;;; same backend protocol, so nothing below this point knows which one is in
;;; use.
;;;
;;; The device holds one model at a time. The catalog lists every model the
;;; server can serve; the residency manager loads a model when a request for it
;;; reaches the front of the engine's queue, unloading the resident one first.
;;; Only the first chat model is loaded at startup, exactly as a single-model
;;; server always loaded its model up front; the others are listed as unloaded
;;; and load on demand.

(define backend-name (option 'backend "real"))

(define backend
  (case (string->symbol backend-name)
    ((real) (make-real-backend))
    ((mock) (make-mock-backend))
    (else (error "unknown backend (expected real or mock):" backend-name))))

(define max-sessions
  (option 'max-sessions (if (equal? backend-name "real") 1 4)))
(define token-budget (option 'token-budget 32768))

(define (mock-config id family)
  `((id . ,id) (family . ,family)
    (context-length . ,(option 'context-length 8192))
    (step-delay . ,(option 'step-delay 0))
    (prefill-delay . ,(option 'prefill-delay 0))))

(define model-path (option 'model "models/qwen2.5-7b-instruct-1m-q4_k_m.gguf"))
(define model-id (option 'model-id "qwen2.5-7b"))

(define image-model-path (option 'image-model "models/MOSS-Image-SFT"))
(define image-model-id "moss-image")

(define catalog
  (append
   (case (string->symbol backend-name)
     ((mock) (list (make-residency-entry "sonicboom-mock-gemma" 'chat
                                         (mock-config "sonicboom-mock-gemma" 'gemma))
                   (make-residency-entry "sonicboom-mock-qwen" 'chat
                                         (mock-config "sonicboom-mock-qwen" 'qwen))))
     (else
      (list (make-residency-entry
             model-id 'chat
             `((id . ,model-id) (path . ,model-path)
               (context-length . ,(option 'context-length 16384)))))))
   (list (make-residency-entry image-model-id 'image image-model-path
                               #:arch "moss-image"))))

(define engine
  (make-engine '()
               #:queue-limit queue-limit
               #:ids (map residency-entry-id catalog)
               ;; The device is idle when this runs: make the request's model
               ;; the one on it.
               #:prepare (lambda (request)
                           (residency-ensure! residency (chat-request-model request)))))

(define residency
  (make-residency engine catalog
                  #:backend backend
                  #:max-sessions max-sessions
                  #:token-budget token-budget
                  #:image-loader load-image-model
                  #:image-unloader free-image-model!
                  #:image-arch image-model-arch
                  ;; Only a real device has buffers to return; the mock has no
                  ;; library to call.
                  #:trim (if (equal? backend-name "real")
                             device-trim!
                             (lambda () #f))))

;; Like a single-model server, the first chat model is loaded before the
;; server serves anything; a failed load fails startup as it always did.
(residency-load! residency
                 (or (find (lambda (id) (eq? 'chat (residency-kind residency id)))
                           (residency-ids residency))
                     (error "the catalog has no chat model")))

;; The style registry: named, versioned style assets a chat request asks for
;; with "sonicboom": {"style": {"id", "version", "alpha"}}. In memory; created
;; under the engine's queue (a vector is measured with the model resident).
(define styles (make-style-registry))

(define start-time (car (gettimeofday)))
(define (now) (car (gettimeofday)))

;;; ---------------------------------------------------------------------------
;;; Reproducibility
;;;
;;; Every reply carries its seed (null when greedy), the sonicboom object
;;; (fingerprint, replay_id, guarantee) and, when sampling, the header
;;; X-SonicBoom-Seed. The fingerprint names the scope inside which the same
;;; request and seed are bit-identical: engine version and commit, numerics
;;; profile, GPU and driver, tune-table digest and the model file's SHA-256
;;; prefix (see (sonicboom serve fingerprint)).
;;;
;;; replay_id always names the reply; only a server started with
;;; --replay-store keeps the request body, so only there can the reply be
;;; regenerated. (The body is stored locally, verbatim apart from the seed,
;;; and is never part of the request log.)

(define model-files
  (if (equal? backend-name "real")
      (list (cons model-id model-path))
      '()))

(define (model-file id) (assoc-ref model-files id))

(define fingerprint-cache (make-hash-table))

(define (fingerprint-of model)
  (or (hash-ref fingerprint-cache model)
      (let ((fp (fingerprint-for-model model (model-file model))))
        (hash-set! fingerprint-cache model fp)
        fp)))

;; The reply's seed: the request's seed when it samples, null when greedy.
(define (response-seed request)
  (if (> (chat-request-temperature request) 0)
      (chat-request-seed request)
      'null))

(define (new-replay-id)
  (format #f "rp-~16,'0x~16,'0x"
          (random (expt 2 64) (random-state-from-platform))
          (random (expt 2 64) (random-state-from-platform))))

(define (sonicboom-object fingerprint replay-id)
  `(("fingerprint" . ,fingerprint)
    ("replay_id" . ,replay-id)
    ("guarantee" . "bit-identical")))

;; A null seed has no header value; a greedy reply omits the header.
(define (seed-headers seed)
  (if (eq? seed 'null) '() `((X-SonicBoom-Seed . ,(number->string seed)))))

(define replay-dir (option 'replay-store #f))

(when replay-dir
  (unless (zero? (system* "mkdir" "-p" replay-dir))
    (error "cannot create the replay store:" replay-dir)))

(define replay-lock (make-mutex))

(define (replay-path id) (string-append replay-dir "/" id ".json"))

(define (valid-replay-id? s)
  (and (string? s) (<= 3 (string-length s) 80)
       (string-every (lambda (c)
                       (or (char-alphabetic? c) (char-numeric? c)
                           (memv c '(#\- #\_))))
                     s)))

(define (body-with-seed body seed)
  (if (eq? seed 'null)
      body
      (cons `("seed" . ,seed)
            (remove (lambda (kv) (equal? (car kv) "seed")) body))))

(define (replay-store! id seed model body fingerprint)
  (when (and replay-dir (valid-replay-id? id))
    (with-mutex replay-lock
      (call-with-output-file (replay-path id)
        (lambda (port)
          (display (scm->json-string
                    `(("replay_id" . ,id)
                      ("seed" . ,seed)
                      ("model" . ,model)
                      ("time" . ,(now))
                      ("fingerprint" . ,(assoc-ref fingerprint "id"))
                      ("request" . ,(body-with-seed body seed))))
                   port)
          (newline port))))))

(define (replay-load id)
  (and replay-dir (valid-replay-id? id) (file-exists? (replay-path id))
       (catch #t
         (lambda ()
           (call-with-input-file (replay-path id)
             (lambda (port) (json-normalize (json-string->scm (get-string-all port))))))
         (lambda _ #f))))

(define (replay-records)
  (if (not replay-dir)
      '()
      (filter-map
       (lambda (name)
         (and (string-suffix? ".json" name)
              (replay-load (string-drop-right name 5))))
       (scandir replay-dir (lambda (name) (not (member name '("." ".."))))))))

(define (html-escape s)
  (call-with-output-string
    (lambda (out)
      (string-for-each
       (lambda (c)
         (case c
           ((#\&) (display "&amp;" out))
           ((#\<) (display "&lt;" out))
           ((#\>) (display "&gt;" out))
           ((#\") (display "&quot;" out))
           (else (write-char c out))))
       s))))

(define (history-html)
  (let ((rows (sort (replay-records)
                    (lambda (a b)
                      (> (or (assoc-ref a "time") 0)
                         (or (assoc-ref b "time") 0))))))
    (string-append
     "<!doctype html><html><head><meta charset=\"utf-8\"><title>SonicBoom replay history</title>"
     "<style>body{font-family:monospace;margin:2em}td,th{padding:.2em .8em;text-align:left}"
     "td.seed{color:#666}</style></head><body><h1>Replay history</h1>"
     "<table><tr><th>time</th><th>model</th><th>seed</th><th></th></tr>"
     (string-concatenate
      (map (lambda (r)
             (let ((id (or (assoc-ref r "replay_id") ""))
                   (seed (assoc-ref r "seed"))
                   (model (or (assoc-ref r "model") ""))
                   (time (or (assoc-ref r "time") 0)))
               (format #f
                       "<tr><td>~a</td><td>~a</td><td class=\"seed\">~a</td>\
<td><a href=\"#\" onclick=\"fetch('/sonicboom/replay/~a',{method:'POST'}).then(r=>r.text()).then(t=>{document.getElementById('out').textContent=t});return false\">replay</a> ~a</td></tr>"
                       time (html-escape model)
                       (if (eq? seed 'null) "greedy" (html-escape (number->string seed)))
                       (html-escape id)
                       (if (eq? seed 'null) ""
                           (format #f "<a href=\"#\" onclick=\"navigator.clipboard.writeText('~a');return false\">copy seed</a>"
                                   seed)))))
           (if (> (length rows) 100) (take rows 100) rows)))
     "</table><pre id=\"out\"></pre></body></html>")))

;;; ---------------------------------------------------------------------------
;;; Generation jobs
;;;
;;; An image generation can be long, and a client may leave (an SSE write then
;;; fails) or cancel it by id. A job is registered before it takes its place in
;;; the queue, so the id — returned in the response header sonicboom-job-id —
;;; is known from the start. Cancelling sets a flag that the generation's
;;; progress callback reads after every denoising step; the C ABI then stops
;;; the generation and releases the buffers it had allocated. A job is
;;; unregistered when its request ends, so a later DELETE is a 404.

(define jobs (make-hash-table))
(define jobs-lock (make-mutex))

(define-record-type <job>
  (make-job* id cancelled?)
  job?
  (id job-id)
  (cancelled? job-cancelled? set-job-cancelled?!))

(define (new-job-id)
  (format #f "job-~8,'0x~8,'0x"
          (random (expt 2 32)) (random (expt 2 32))))

(define (job-register!)
  (let ((job (make-job* (new-job-id) #f)))
    (with-mutex jobs-lock (hash-set! jobs (job-id job) job))
    job))

(define (job-unregister! job)
  (with-mutex jobs-lock (hash-remove! jobs (job-id job))))

;; The job with this id, marked cancelled, or #f when there is no such job.
(define (job-cancel! id)
  (with-mutex jobs-lock
    (match (hash-ref jobs id)
      (#f #f)
      (job (set-job-cancelled?! job #t) job))))

(define (job-cancelled-now? job)
  (with-mutex jobs-lock (job-cancelled? job)))

(define (cancelled-condition? key args)
  (and (eq? key '%exception)
       (let ((c (car args)))
         (and (sonicboom-error? c)
              (eq? 'cancelled (sonicboom-error-kind c))))))

;;; ---------------------------------------------------------------------------
;;; The image model joins the same catalog and queue: a generation switches the
;;; device to MOSS-Image (unloading the chat model first) and switches back on
;;; the next chat request.

;; The C ABI's PNG writer takes a path, so encode through a temporary file and
;; read the bytes back. Each request has its own file name; it is removed even
;; when the write fails.
(define (png-bytes width height rgb)
  (let ((path (format #f "~a/image-~a-~a.png" runtime-dir (getpid)
                      (random 1000000000))))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (write-png path rgb width height)
        (call-with-input-file path get-bytevector-all))
      (lambda ()
        (catch #t (lambda () (delete-file path)) (lambda _ #f))))))

;; REQUEST is the alist parse-image-request returns; the caller made the image
;; model resident. The result is the list of base64 PNGs for the response's
;; data array. PROGRESS (image step total) is the generation's progress
;; callback, called after each denoising step; #f means no callback.
(define* (render-images request #:key (progress #f))
  (let ((images (generate-images
                 (residency-model residency image-model-id)
                 #:prompt (assoc-ref request "prompt")
                 #:negative (assoc-ref request "negative_prompt")
                 #:width (assoc-ref request "width")
                 #:height (assoc-ref request "height")
                 #:steps (assoc-ref request "steps")
                 #:guidance (assoc-ref request "guidance_scale")
                 #:seed (assoc-ref request "seed")
                 #:batch (assoc-ref request "n")
                 #:progress progress)))
    (map (lambda (image)
           (base64-encode-bytevector
            (png-bytes (car image) (cadr image) (caddr image))))
         images)))

;; One SSE progress event: the step just completed, the total, and the image
;; of the batch it belongs to.
(define (progress-object image step total)
  `(("step" . ,step) ("total" . ,total) ("image" . ,image)))

;; The generation's progress callback. It returns #f — stopping the generation
;; after the current step — when the job was cancelled by DELETE, or when SEND
;; (the SSE writer) failed because the client is gone; otherwise a streaming
;; request sends one event per denoising step. SEND is #f for a non-streaming
;; request, whose cancellation is only by id.
(define (image-progress job send)
  (lambda (image step total)
    (and (not (job-cancelled-now? job))
         (or (not send)
             (send (json-ascii-string (progress-object image step total)))))))

;; The body of a streaming image request, run by the SSE producer. The final
;; event is the same images object the non-stream reply holds (the same PNGs);
;; a cancellation ends it with {"id", "status": "cancelled"} instead, and
;; "[DONE]" ends the stream either way.
(define (stream-images job request ctx send)
  (let ((status
         (catch #t
           (lambda ()
             (if (send (json-ascii-string
                        (images-object
                         (now)
                         ;; The producer thread has no request context of its
                         ;; own (dynamic parameters do not reach it); the
                         ;; request's record is passed in so the ticket is
                         ;; noted there.
                         (run-job
                          (lambda ()
                            (residency-ensure! residency image-model-id)
                            (render-images request
                                           #:progress (image-progress job send)))
                          ctx))))
                 'done
                 'cancelled))
           (lambda (key . args)
             (send (json-ascii-string
                    (if (cancelled-condition? key args)
                        `(("id" . ,(job-id job)) ("status" . "cancelled"))
                        (error-object-of key args))))
             (if (cancelled-condition? key args) 'cancelled 'failed)))))
    (send "[DONE]")
    (request-log-finish! ctx status)))

;;; ---------------------------------------------------------------------------
;;; Helpers

(define* (json-emit status obj #:key (headers '()))
  (response-emit (scm->json-string obj) #:status status
                 #:headers (append headers '((content-type . (application/json))))))

;; An SSE event body must be one byte per character: the event writer counts
;; characters for its chunk headers and the socket port it writes through is
;; ISO-8859-1. scm->json-string with #:unicode escapes most non-ASCII
;; characters but leaves Latin-1 raw, so escape everything above ASCII.
(define (json-ascii-string obj)
  (call-with-output-string
   (lambda (out)
     (string-for-each
      (lambda (ch)
        (let ((n (char->integer ch)))
          (cond
           ((< n 128) (write-char ch out))
           ((< n #x10000) (format out "\\u~4,'0x" n))
           (else
            (let ((m (- n #x10000)))
              (format out "\\u~4,'0x\\u~4,'0x"
                      (+ #xd800 (quotient m #x400))
                      (+ #xdc00 (remainder m #x400))))))))
      (scm->json-string obj #:unicode #t)))))

(define (error-emit status type message param code)
  (json-emit status (openai-error-object type message param code)))

(define (read-json-body rc)
  (let ((body (rc-body rc)))
    (unless body
      (raise-openai-error 400 "invalid_request_error" "the request body is empty"))
    (catch #t
      (lambda () (json-normalize (json-string->scm (utf8->string body))))
      (lambda _
        (raise-openai-error 400 "invalid_request_error" "the request body is not valid JSON")))))

;; Exceptions from parsing, admission and generation -> (status type message
;; param code).
(define (classify key args)
  (match (cons key args)
    (('openai-error status type message param) (list status type message param 'null))
    (('queue-full waiting)
     (list 429 "rate_limit_error"
           (format #f "the request queue is full (~a waiting)" waiting) 'null "queue_full"))
    (('model-not-found id)
     (list 404 "invalid_request_error"
           (format #f "The model `~a' does not exist" id) "model" "model_not_found"))
    (('job-not-found id)
     (list 404 "invalid_request_error"
           (format #f "The job `~a' does not exist" id) 'null "job_not_found"))
    (('replay-not-found id)
     (list 404 "invalid_request_error"
           (format #f "The reply `~a' is not in the replay store" id)
           'null "replay_not_found"))
    (('context-length-exceeded n ctx)
     (list 400 "invalid_request_error"
           (format #f "the prompt has ~a tokens, the context length is ~a" n ctx)
           "messages" "context_length_exceeded"))
    (('invalid-constraint param message)
     (list 400 "invalid_request_error" message param "invalid_constraint"))
    (('style-invalid param message)
     (list 400 "invalid_request_error" message param "invalid_style"))
    (('style-not-found id)
     (list 404 "invalid_request_error"
           (format #f "The style `~a' does not exist" id)
           "sonicboom" "style_not_found"))
    (('style-version-mismatch id want got)
     (list 409 "invalid_request_error"
           (format #f "The style `~a' is version ~a, not ~a" id got want)
           "sonicboom" "style_version_mismatch"))
    (('style-model-mismatch id want got)
     (list 400 "invalid_request_error"
           (format #f "The style `~a' was measured under `~a', not `~a'"
                   id got want)
           "sonicboom" "style_model_mismatch"))
    ;; A Guile 3 condition raised by a binding module. `catch #t` reports the
    ;; condition itself with the key `%exception`. A &sonicboom-error carries
    ;; the C ABI's message (a failed model load, a generation failure). A
    ;; generation the client cancelled is not a server error: it is a 409.
    (('%exception c)
     (cond
      ((not (sonicboom-error? c))
       (list 500 "server_error" (format #f "internal error: ~a" c) 'null 'null))
      ((eq? 'cancelled (sonicboom-error-kind c))
       (list 409 "invalid_request_error" "the generation was cancelled"
             'null "cancelled"))
      (else
       (let ((message (sonicboom-error-message c)))
         (list 500 "server_error"
               (if (string-null? message) "SonicBoom error" message)
               'null 'null)))))
    (_ (list 500 "server_error" (format #f "~a: ~s" key args) 'null 'null))))

(define (error-object-of key args)
  (match (classify key args)
    ((status type message param code) (openai-error-object type message param code))))

;; Parse a request body and take a place in the queue.
;; -> (values request stream? include-usage? ticket)
(define (admit body)
  (call-with-values (lambda () (parse-chat-request body))
    (lambda (request stream? include-usage?)
      ;; BODY is the request as it arrived (or as the replay store kept it); it
      ;; is returned so the caller can store it for a replay.
      ;; The catalog decides whether the id is served, not the resident model:
      ;; a model that is not on the device right now is loaded when the
      ;; request reaches the front of the queue.
      (unless (eq? 'chat (residency-kind residency (chat-request-model request)))
        (throw 'model-not-found (chat-request-model request)))
      ;; A backend that cannot sample gets an explicit sampling request
      ;; rejected as a 400, not silently decoded greedily. Both shipped
      ;; backends sample; this guards a future one that does not.
      (unless (backend-sampling? backend)
        (check-greedy-body body))
      ;; The body's style spec is resolved against the registry here, before
      ;; the request takes a place in the queue: an unknown id is answered now,
      ;; not when the request reaches the front. Resolution copies the card and
      ;; the scaled vector into the request; the registry is not needed again.
      (let* ((raw-style (chat-request-style request))
             (request
              (if raw-style
                  (chat-request-with-style
                   request
                   (resolve-style-choice styles raw-style
                                         (chat-request-model request)
                                         (assoc-ref raw-style "alpha")))
                  request)))
        ;; Noted before admission: a rejected request's record still says which
        ;; model it asked for.
        (when (current-request-log)
          (request-log-note! (chat-request-model request) 'chat))
        (let ((ticket (engine-admit! engine)))
          (when (current-request-log)
            (request-log-ticket! (current-request-log) ticket))
          (values request stream? include-usage? ticket body))))))

;; Run an admitted request, sending its chunks through send-obj (returns #f
;; once the client is gone). Ends with "[DONE]" through send-text. CTX is the
;; request's log record, or #f; the token counts and the outcome are noted
;; there as they become known.
(define (stream-chunks ticket request include-usage? ctx body seed fingerprint
                       replay-id sonicboom send-obj send-text)
  (let ((id (new-completion-id))
        (created (now))
        (model (chat-request-model request)))
    (define (chunk delta . finish)
      (send-obj (apply chunk-object id created model delta finish)))
    (define (final-chunk delta reason)
      (send-obj (chunk-object id created model delta reason
                              #:seed seed #:sonicboom sonicboom)))
    ;; The first chunk carries the request's seed and the sonicboom object so a
    ;; streaming client can replay the reply.
    (if (not (send-obj (chunk-object id created model (role-delta)
                                     #:seed seed #:sonicboom sonicboom)))
        (begin
          (request-log-finish! ctx 'cancelled)  ; gone before the first chunk
          (engine-drop! engine ticket))
        (catch #t
          (lambda ()
            (let ((result
                   (engine-run engine ticket request
                               (lambda (kind . args)
                                 (match (cons kind args)
                                   (('content text) (chunk (content-delta text)))
                                   (('tool-call index call-id name arguments)
                                    (every chunk (tool-call-deltas index call-id name
                                                                   arguments))))))))
              (request-log-result! ctx result)
              (if (equal? (result-finish-reason result) "cancelled")
                  (request-log-finish! ctx 'cancelled)
                  (let ((done
                         (and (final-chunk (finish-delta) (result-finish-reason result))
                              (or (not include-usage?)
                                  (send-obj (usage-chunk-object id created model
                                                                result
                                                                #:seed seed
                                                                #:sonicboom sonicboom)))
                              (send-text "[DONE]"))))
                    (when done
                      (replay-store! replay-id seed model body fingerprint))
                    (request-log-finish! ctx (if done 'done 'cancelled))))))
          (lambda (key . args)
            (engine-drop! engine ticket)
            (request-log-finish! ctx 'failed)
            (and (send-obj (error-object-of key args))
                 (send-text "[DONE]")))))))

;; Run an arbitrary job (an image generation, a load or an unload) behind the
;; admitted chat requests, waiting for its turn in a runner thread. NOTE: the
;; same as chat: no dynamic-wind around call-with-runner. A failure drops the
;; ticket here; engine-run-job drops it when the job returns. CTX is the
;; request's log record (the current one by default; an SSE producer runs in a
;; thread without the request's dynamic state and passes it explicitly).
(define* (run-job thunk #:optional (ctx (current-request-log)))
  (let ((ticket (engine-admit! engine)))
    (when ctx (request-log-ticket! ctx ticket))
    (catch #t
      (lambda ()
        (call-with-runner
         (lambda () (engine-run-job engine ticket thunk))
         #:timeout 0))
      (lambda (key . args)
        (engine-drop! engine ticket)
        (apply throw key args)))))

(define (alist->json alist)
  (map (match-lambda
         ((k . (? pair? v)) (cons (symbol->string k) (alist->json v)))
         ((k . v) (cons (symbol->string k) v)))
       alist))

;;; ---------------------------------------------------------------------------
;;; Request log
;;;
;;; With --request-log PATH every request to a route below appends one JSON
;;; object as one line. It records metadata only — a request body (a prompt, a
;;; conversation, an image instruction) is never written:
;;;
;;;   id, time (start, Unix seconds), end (Unix seconds), method, path,
;;;   status (done / failed / cancelled / rejected), ms (the whole request),
;;;   model, kind (chat / image), queue_ms (the wait for the device),
;;;   switch_ms (the model switch made for this request, when one happened),
;;;   prompt_tokens, completion_tokens, cached_tokens (chat),
;;;   size [width height], steps, n (image),
;;;   free_mib_start, free_mib_end (device memory free, from nvidia-smi; null
;;;   when it cannot be read).
;;;
;;; A route that answers immediately is logged by the wrapper when the handler
;;; returns, with the status its response chose (429 is a rejection; any other
;;; 4xx/5xx a failure). An SSE producer runs after the response is registered,
;;; so its route claims the record (request-log-defer!) and the producer —
;;; the only place that sees the end of the stream — writes it.

(define request-log-path (option 'request-log #f))
(define request-log-lock (make-mutex))

;; Fail at startup, not at the first request, when the path is unusable.
(when request-log-path
  (let ((port (open-file request-log-path "a"))) (close-port port)))

;; One request's record. Everything that is only known later (the model, the
;; token counts, the outcome) is filled in as it becomes known; the ticket
;; carries the queue wait, and switches is the residency counter sampled when
;; the request started, so a change means a switch happened for it.
(define-record-type <request-log>
  (%make-request-log id method path start free-start switches
                     seed fingerprint replay-id)
  request-log?
  (id request-log-id)
  (method request-log-method)
  (path request-log-rule)  ; the route, not the log file's path
  (start request-log-start)
  (free-start request-log-free-start)
  (switches request-log-switches)
  (seed request-log-seed set-request-log-seed!)
  (fingerprint request-log-fingerprint set-request-log-fingerprint!)
  (replay-id request-log-replay-id set-request-log-replay-id!)
  (model request-log-model set-request-log-model!)
  (kind request-log-kind set-request-log-kind!)
  (ticket request-log-ticket set-request-log-ticket!)
  (prompt-tokens request-log-prompt-tokens set-request-log-prompt-tokens!)
  (completion-tokens request-log-completion-tokens
                     set-request-log-completion-tokens!)
  (cached-tokens request-log-cached-tokens set-request-log-cached-tokens!)
  (size request-log-size set-request-log-size!)
  (steps request-log-steps set-request-log-steps!)
  (n request-log-n set-request-log-n!)
  (status request-log-status set-request-log-status!)
  (deferred? request-log-deferred? set-request-log-deferred?!)
  (done? request-log-done? set-request-log-done?!))

(define current-request-log (make-parameter #f))
(define request-log-counter 0)
(define request-log-counter-lock (make-mutex))

(define (new-request-id)
  (with-mutex request-log-counter-lock
    (set! request-log-counter (1+ request-log-counter))
    (format #f "req-~8,'0x-~a" (car (gettimeofday)) request-log-counter)))

;; A value for the JSON document: the value, or null.
(define (or-null v) (if v v 'null))

(define (tv-diff-ms a b)
  (inexact->exact
   (round (* 1000 (+ (- (car b) (car a))
                     (/ (- (cdr b) (cdr a)) 1000000.0))))))

;; Note what is known about the request being served in this thread, if it is
;; being logged.
(define (request-log-note! model kind)
  (let ((ctx (current-request-log)))
    (when ctx
      (set-request-log-model! ctx model)
      (set-request-log-kind! ctx kind))))

(define (request-log-ticket! ctx ticket)
  (when ctx (set-request-log-ticket! ctx ticket)))

;; The chat result's token counts.
(define (request-log-result! ctx result)
  (when ctx
    (set-request-log-prompt-tokens! ctx (result-prompt-tokens result))
    (set-request-log-completion-tokens! ctx (result-completion-tokens result))
    (set-request-log-cached-tokens! ctx (result-cached-tokens result))))

;; The reproducibility fields: the reply's seed (null when greedy), the
;; fingerprint's id and the replay id. No body, as always.
(define (request-log-repro! ctx seed fingerprint replay-id)
  (when ctx
    (set-request-log-seed! ctx seed)
    (set-request-log-fingerprint! ctx (assoc-ref fingerprint "id"))
    (set-request-log-replay-id! ctx replay-id)))

;; The image request's shape: size (width height), steps and batch count.
(define (request-log-image! ctx request)
  (when ctx
    (set-request-log-size! ctx (list (assoc-ref request "width")
                                     (assoc-ref request "height")))
    (set-request-log-steps! ctx (assoc-ref request "steps"))
    (set-request-log-n! ctx (assoc-ref request "n"))))

;; This request's outcome is written by someone else (an SSE producer). Until
;; it does, the wrapper leaves the record alone; if registering the response
;; itself fails, the claim is undone so the wrapper still writes the failure.
(define (request-log-deferred ctx thunk)
  (if ctx
      (begin
        (set-request-log-deferred?! ctx #t)
        (catch #t
          (lambda () (thunk))
          (lambda (key . args)
            (set-request-log-deferred?! ctx #f)
            (apply throw key args))))
      (thunk)))

;; Write the record, once. STATUS is one of done, failed, cancelled, rejected.
(define (request-log-finish! ctx status)
  (when (and ctx request-log-path status)
    (with-mutex request-log-lock
      (unless (request-log-done? ctx)
        (set-request-log-done?! ctx #t)
        (let* ((end (gettimeofday))
               (switches-now (residency-switch-count residency))
               (ticket (request-log-ticket ctx))
               (size (request-log-size ctx))
               (line
                (scm->json-string
                 `(("id" . ,(request-log-id ctx))
                   ("time" . ,(car (request-log-start ctx)))
                   ("end" . ,(car end))
                   ("method" . ,(symbol->string (request-log-method ctx)))
                   ("path" . ,(request-log-rule ctx))
                   ("status" . ,(symbol->string status))
                   ("ms" . ,(tv-diff-ms (request-log-start ctx) end))
                   ("model" . ,(or-null (request-log-model ctx)))
                   ("kind" . ,(or-null (and (request-log-kind ctx)
                                            (symbol->string
                                             (request-log-kind ctx)))))
                   ("queue_ms" . ,(or-null (and ticket
                                                (engine-ticket-wait-ms ticket))))
                   ("switch_ms" . ,(or-null
                                    (and (not (= switches-now
                                                 (request-log-switches ctx)))
                                         (residency-last-switch-ms residency))))
                   ("prompt_tokens" . ,(or-null
                                        (request-log-prompt-tokens ctx)))
                   ("completion_tokens" . ,(or-null
                                            (request-log-completion-tokens ctx)))
                   ("cached_tokens" . ,(or-null
                                        (request-log-cached-tokens ctx)))
                   ("seed" . ,(or-null (request-log-seed ctx)))
                   ("fingerprint" . ,(or-null (request-log-fingerprint ctx)))
                   ("replay_id" . ,(or-null (request-log-replay-id ctx)))
                   ("size" . ,(or-null (and size (list->vector size))))
                   ("steps" . ,(or-null (request-log-steps ctx)))
                   ("n" . ,(or-null (request-log-n ctx)))
                   ("free_mib_start" . ,(or-null (request-log-free-start ctx)))
                   ("free_mib_end" . ,(or-null (residency-free-vram-mib))))))
               (port (open-file request-log-path "a")))
          (display line port)
          (newline port)
          (close-port port))))))

;; The value of a keyword in the response-emit argument list, or DEFAULT.
(define (keyword-ref args key default)
  (let loop ((a args))
    (cond ((null? a) default)
          ((eq? (car a) key) (cadr a))
          (else (loop (cddr a))))))

;; Wrap a route handler so it logs its request when it answers. The status is
;; the one the handler's response-emit chose: a 429 is a rejection, any other
;; error a failure. A handler-producer pair that claims the record
;; (request-log-deferred) writes it itself. The response values pass through
;; untouched.
(define (logged handler)
  (lambda (rc)
    (let* ((start (gettimeofday))
           (ctx (and request-log-path
                     (%make-request-log (new-request-id)
                                        (rc-method rc) (rc-path rc) start
                                        (residency-free-vram-mib)
                                        (residency-switch-count residency)
                                        #f #f #f))))
      (parameterize ((current-request-log ctx))
        (call-with-values
            (lambda () (handler rc))
          (lambda (body . rest)
            (when (and ctx (not (request-log-deferred? ctx)))
              (let ((code (keyword-ref rest #:status 200)))
                (request-log-finish!
                 ctx
                 (or (request-log-status ctx)
                     (cond ((= code 429) 'rejected)
                           ((>= code 400) 'failed)
                           (else 'done))))))
            (apply values body rest)))))))

;; The routes below register through these so every plain HTTP request is
;; logged. get / post / page-delete take the handler as their last argument,
;; options before it. The WebSocket route stays on get: its handler is a
;; callback factory, not a response.
(define (logged-register register rule opts-and-handler)
  (let* ((rev (reverse opts-and-handler))
         (handler (logged (car rev))))
    (apply register rule (reverse (cons handler (cdr rev))))))

(define (logged-get rule . rest) (logged-register get rule rest))
(define (logged-post rule . rest) (logged-register post rule rest))
(define (logged-delete rule . rest) (logged-register page-delete rule rest))

;;; ---------------------------------------------------------------------------
;;; Routes

(logged-get "/health" (lambda (rc) "ok"))

(logged-get "/v1/models" #:mime 'json
  (lambda (rc)
    (:mime rc
           `(("object" . "list")
             ("data"
              . ,(list->vector
                  (filter-map
                   (lambda (id)
                     (and (eq? 'chat (residency-kind residency id))
                          (model-object id (residency-family residency id)
                                        start-time
                                        #:loaded (residency-loaded? residency id))))
                   (residency-ids residency))))))))

(logged-get "/v1/models/:id"
  (lambda (rc)
    (let ((id (params rc "id")))
      (if (eq? 'chat (residency-kind residency id))
          (json-emit 200 (model-object id (residency-family residency id)
                                       start-time
                                       #:loaded (residency-loaded? residency id)))
          (apply error-emit (classify 'model-not-found (list id)))))))

;; Every served model, chat and image, with its residency state. Only one of
;; them is loaded at a time (the one the last job left on the device).
(logged-get "/sonicboom/models" #:mime 'json
  (lambda (rc)
    (:mime rc
           `(("object" . "list")
             ("data"
              . ,(list->vector
                  (map (lambda (id)
                         (alist->json (residency-info residency id)))
                       (residency-ids residency))))))))

;; Load and unload are ordinary jobs: they queue behind running work and
;; switch the device only when it is idle. A load switches away from the
;; resident model, exactly as a request for this model would.
(logged-post "/sonicboom/models/:id/load"
  (lambda (rc)
    (let ((id (params rc "id")))
      (catch #t
        (lambda ()
          (unless (residency-known? residency id)
            (throw 'model-not-found id))
          (request-log-note! id (residency-kind residency id))
          (run-job (lambda () (residency-load! residency id)))
          (json-emit 200 (alist->json (residency-info residency id))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

(logged-post "/sonicboom/models/:id/unload"
  (lambda (rc)
    (let ((id (params rc "id")))
      (catch #t
        (lambda ()
          (unless (residency-known? residency id)
            (throw 'model-not-found id))
          (request-log-note! id (residency-kind residency id))
          (run-job (lambda () (residency-unload! residency id)))
          (json-emit 200 (alist->json (residency-info residency id))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

(logged-post "/v1/chat/completions"
  (lambda (rc)
    (let ((ctx (current-request-log)))
      (catch #t
        (lambda ()
          (call-with-values (lambda () (admit (read-json-body rc)))
            (lambda (request stream? include-usage? ticket body)
              (let* ((model (chat-request-model request))
                     (seed (response-seed request))
                     (fingerprint (fingerprint-of model))
                     (replay-id (new-replay-id))
                     (sonicboom (sonicboom-object fingerprint replay-id))
                     (headers (seed-headers seed)))
                (request-log-repro! ctx seed fingerprint replay-id)
                (if stream?
                    ;; The producer runs after this handler returns, in a
                    ;; thread of its own: it gets the record explicitly and
                    ;; writes it when the stream ends.
                    (request-log-deferred
                     ctx
                     (lambda ()
                       (sse-response
                        (lambda (send)
                          (stream-chunks ticket request include-usage? ctx body
                                         seed fingerprint replay-id sonicboom
                                         (lambda (obj)
                                           (send (json-ascii-string obj)))
                                         send))
                        #:headers headers)))
                    ;; NOTE: No dynamic-wind around call-with-runner: the task
                    ;;       is suspended by aborting to the Ragnarok scheduler,
                    ;;       which would run the after thunk while the runner
                    ;;       still works. engine-run leaves the queue itself.
                    (let ((result (catch #t
                                    (lambda ()
                                      (call-with-runner
                                       (lambda () (engine-run engine ticket request
                                                              (lambda _ #t)))
                                       #:timeout 0))
                                    (lambda (key . args)
                                      (engine-drop! engine ticket)
                                      (apply throw key args)))))
                      (request-log-result! ctx result)
                      (replay-store! replay-id seed model body fingerprint)
                      (json-emit 200 (completion-object
                                      (new-completion-id) (now) model result
                                      #:seed seed #:sonicboom sonicboom)
                                #:headers headers)))))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

;; Image generation is blocking and long, so it runs in a runner thread like a
;; chat completion (same NOTE as above: no dynamic-wind around the runner),
;; and it takes the same queue: the job switches the device to the image model
;; before it renders and leaves it resident until another job switches away.
;;
;; stream=false answers with the images object, as before, plus the
;; sonicboom-job-id header. stream=true answers with SSE: one
;; {"step","total","image"} event per denoising step, then the images object,
;; then "[DONE]". Either way the job can be cancelled by id; a cancellation
;; answers 409 (non-stream) or {"id","status":"cancelled"} (stream).
(logged-post "/v1/images/generations"
  (lambda (rc)
    (let ((ctx (current-request-log)))
      (catch #t
        (lambda ()
          (let* ((body (read-json-body rc))
                 (stream? (eq? #t (assoc-ref body "stream")))
                 (request (parse-image-request body))
                 (job (job-register!))
                 (headers `((sonicboom-job-id . ,(job-id job)))))
            (request-log-note! image-model-id 'image)
            (request-log-image! ctx request)
            (if stream?
                ;; The producer writes the record when the stream ends.
                (request-log-deferred
                 ctx
                 (lambda ()
                   (sse-response
                    (lambda (send)
                      ;; The producer always runs, even when the client is
                      ;; already gone, so the job is unregistered either way.
                      (dynamic-wind
                        (lambda () #t)
                        (lambda () (stream-images job request ctx send))
                        (lambda () (job-unregister! job))))
                    #:headers headers)))
                (catch #t
                  (lambda ()
                    (let ((b64s (run-job
                                 (lambda ()
                                   (residency-ensure! residency image-model-id)
                                   (render-images request
                                                  #:progress
                                                  (image-progress job #f))))))
                      (job-unregister! job)
                      (json-emit 200 (images-object (now) b64s)
                                 #:headers headers)))
                  (lambda (key . args)
                    (job-unregister! job)
                    (when (and ctx (cancelled-condition? key args))
                      (set-request-log-status! ctx 'cancelled))
                    (apply throw key args))))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

;; Cancel a running or queued generation. The device work stops after the
;; current denoising step and its buffers are released; the response names the
;; job and its status. An unknown id (a finished job included) is a 404.
;; NOTE: Artanis exports the DELETE route as page-delete; its usual name,
;;       delete, is the (srfi srfi-1) procedure here.
(logged-delete "/sonicboom/jobs/:id"
  (lambda (rc)
    (let ((id (params rc "id")))
      (if (job-cancel! id)
          (json-emit 200 `(("id" . ,id) ("status" . "cancelled")))
          (apply error-emit (classify 'job-not-found (list id)))))))

;; Threads for WebSocket replies run in the dynamic state of the app at load
;; time, like Artanis' runners, not in the one of the Ragnarok task that
;; spawns them (whose port waiters would suspend the task).
(define clean-dynamic-state (current-dynamic-state))

(define (spawn thunk)
  (call-with-new-thread
   (lambda ()
     (with-dynamic-state
      clean-dynamic-state
      (lambda ()
        (catch #t thunk
          (lambda (key . args)
            (format (current-error-port) "ws: reply failed: ~a ~s~%" key args))))))))

;; One chat request per text message; the reply is the stream of chunk
;; objects as text messages, then "[DONE]". A bad request gets an error
;; object (and no "[DONE]").
;; NOTE: Not call-with-runner here: the task of a connection is the only
;;       writer of its socket, and it writes the messages queued by ws-send
;;       only while it waits for the peer. So on-message returns at once and
;;       the reply is generated in a thread; the task then streams the queued
;;       chunks, and sees the peer go away (ws-send returns 'closed).
(get "/v1/ws/chat" #:websocket 'raw #:timeout 0
  (lambda (rc)
    (lambda (conn msg)
      (define (send-text s) (eq? #t (ws-send conn s)))
      (define (send-obj o) (send-text (scm->json-string o)))
      (catch #t
        (lambda ()
          (call-with-values
              (lambda ()
                (admit (catch #t
                         (lambda ()
                           (json-normalize (json-string->scm (ws-message-text msg))))
                         (lambda _
                           (raise-openai-error 400 "invalid_request_error"
                                               "the message is not valid JSON")))))
            (lambda (request stream? include-usage? ticket body)
              (let* ((model (chat-request-model request))
                     (seed (response-seed request))
                     (fingerprint (fingerprint-of model))
                     (replay-id (new-replay-id))
                     (sonicboom (sonicboom-object fingerprint replay-id)))
                (spawn
                 (lambda ()
                   (stream-chunks ticket request include-usage? #f body seed
                                  fingerprint replay-id sonicboom send-obj
                                  send-text)))))))
        (lambda (key . args)
          (send-obj (error-object-of key args)))))))

;; Regenerate a stored reply. The stored body already carries the seed that
;; drew it, so the engine draws the same tokens; the reply keeps the replay id
;; and reports the current fingerprint. A server whose fingerprint changed
;; since the record was written answers "fingerprint-mismatch" rather than the
;; bit-identical guarantee.
(logged-post "/sonicboom/replay/:id"
  (lambda (rc)
    (let ((id (params rc "id")))
      (catch #t
        (lambda ()
          (let ((record (replay-load id)))
            (unless record (throw 'replay-not-found id))
            (let ((body (assoc-ref record "request"))
                  (seed (assoc-ref record "seed"))
                  (model (assoc-ref record "model"))
                  (stored-fp (assoc-ref record "fingerprint")))
              (call-with-values (lambda () (admit body))
                (lambda (request stream? include-usage? ticket _)
                  (let* ((fingerprint (fingerprint-of (chat-request-model request)))
                         (sonicboom
                          `(("fingerprint" . ,fingerprint)
                            ("replay_id" . ,id)
                            ("guarantee" .
                             ,(if (equal? stored-fp (assoc-ref fingerprint "id"))
                                  "bit-identical"
                                  "fingerprint-mismatch")))))
                    (request-log-repro! (current-request-log) seed fingerprint id)
                    (let ((result (catch #t
                                    (lambda ()
                                      (call-with-runner
                                       (lambda () (engine-run engine ticket request
                                                              (lambda _ #t)))
                                       #:timeout 0))
                                    (lambda (key . args)
                                      (engine-drop! engine ticket)
                                      (apply throw key args)))))
                      (request-log-result! (current-request-log) result)
                      (json-emit 200 (completion-object
                                      (new-completion-id) (now) model result
                                      #:seed seed #:sonicboom sonicboom)
                                #:headers (seed-headers seed)))))))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

;; The replay store as a minimal page: time, model, seed, and one link to
;; regenerate each reply plus one to copy its seed. Empty without
;; --replay-store.
(logged-get "/sonicboom/history"
  (lambda (rc)
    (response-emit (history-html)
                   #:headers '((content-type . (text/html (charset . "utf-8")))))))

;;; ---------------------------------------------------------------------------
;;; Style assets. A style is created here under the engine's queue: building
;;; its steering vector runs the backend's residual capture with the model
;;; resident. Creating a style again under the same id replaces it. The
;;; registry is in memory and goes with the process.

(logged-get "/sonicboom/styles" #:mime 'json
  (lambda (rc)
    (:mime rc
           `(("object" . "list")
             ("data" . ,(list->vector
                         (map style-json (style-list styles))))))))

(logged-post "/sonicboom/styles"
  (lambda (rc)
    (catch #t
      (lambda ()
        (let* ((spec (parse-style-create (read-json-body rc)))
               (id (assq-ref spec 'id))
               (model-id (assq-ref spec 'model)))
          (unless (eq? 'chat (residency-kind residency model-id))
            (throw 'model-not-found model-id))
          (request-log-note! model-id 'chat)
          (run-job
           (lambda ()
             (residency-ensure! residency model-id)
             (style-create! styles spec (residency-model residency model-id))))
          (json-emit 200 (style-json (style-ref styles id)))))
      (lambda (key . args)
        (apply error-emit (classify key args))))))

;; A resolved style is copied into each request as it is admitted, so deleting
;; one stops new requests from using it; requests already running finish.
(logged-delete "/sonicboom/styles/:id"
  (lambda (rc)
    (let ((id (params rc "id")))
      (catch #t
        (lambda ()
          (unless (style-delete! styles id)
            (throw 'style-not-found id))
          (json-emit 200 `(("id" . ,id) ("deleted" . #t))))
        (lambda (key . args)
          (apply error-emit (classify key args)))))))

(logged-get "/sonicboom/stats" #:mime 'json
  (lambda (rc)
    (:mime rc
           `(("engine" . ,(alist->json (engine-stats engine)))
             ("models"
              . ,(map (lambda (id)
                        (let ((m (engine-model engine id)))
                          (cons id
                                (if m
                                    `(("sessions" . ,(alist->json
                                                      (pool-stats (engine-pool engine id))))
                                      ("backend" . ,(alist->json (backend-stats m))))
                                    ;; The residency manager unloaded it; its
                                    ;; counters went with the model.
                                    '(("loaded" . #f))))))
                      (engine-model-ids engine)))))))

(run #:host (option 'host "127.0.0.1") #:port (option 'port 8000))
