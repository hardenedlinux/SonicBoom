;;;
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Copyright (C) 2026 Nala Ginrut <roy@hardenedlinux.org>
;;;
;;; One entry per canonical S-Expr op-name. Each entry carries
;;;   - a type rule:  (input-types attrs) -> output type   used while tracing,
;;;   - a kernel:     (input-ctensors attrs) -> ctensor     used by eager mode and
;;;                                                         the reference interpreter,
;;;   - the corresponding PyTorch Core ATen operator name (#f if none),
;;;   - a gradient rule (#f: not differentiable), see "gradients" below.
;;; A type is a pair (dtype . shape). Keeping both in one table guarantees that
;;; the shapes recorded at trace time are the shapes the interpreter computes.
;;;
;;; This table is the prototype's own; it is not SonicBoom's operator registry.

(define-module (sonicboom trace ops)
  #:use-module (srfi srfi-1)
  #:use-module (sonicboom trace tensor)
  #:export (op-known? op-arity op-type op-kernel op-effectful? attr-ref
            op-aten-name op-gradient op-elementwise? sum-to-shape
            broadcast-shapes))

;;; --- attributes ---------------------------------------------------------------

;; ATTRS is the S-Expr attr list: ((name (tag v ...)) ...).
(define (attr-ref attrs name default)
  (let ((a (assq name attrs)))
    (if (not a)
        default
        (let ((tv (cadr a)))
          (case (car tv)
            ((int float string bool) (cadr tv))
            ((ints floats strings bools) (cdr tv))
            (else (error "attr-ref: unknown attribute tag" tv)))))))

;;; --- shapes -------------------------------------------------------------------

(define (broadcast-shapes . shapes)
  "NumPy-style broadcast of SHAPES; error if incompatible."
  (let* ((rank (apply max 0 (map length shapes)))
         (padded (map (lambda (s) (append (make-list (- rank (length s)) 1) s))
                      shapes)))
    (apply map
           (lambda dims
             (let ((big (filter (lambda (d) (not (= d 1))) dims)))
               (cond ((null? big) 1)
                     ((every (lambda (d) (= d (car big))) big) (car big))
                     (else (error "broadcast: incompatible shapes" shapes)))))
           padded)))

(define (broadcast-shapes* shapes)
  (if (every null? shapes) '() (apply broadcast-shapes shapes)))

;; Row-major strides of SHAPE, with stride 0 on broadcast dims, aligned to
;; OUT-SHAPE.
(define (broadcast-strides shape out-shape)
  (let* ((pad (- (length out-shape) (length shape)))
         (full (append (make-list pad 1) shape))
         (strides (let loop ((ds (reverse full)) (acc 1) (out '()))
                    (if (null? ds) out
                        (loop (cdr ds) (* acc (car ds)) (cons acc out))))))
    (map (lambda (d s) (if (= d 1) 0 s)) full strides)))

;; Call (PROC out-index operand-indices) for every element of OUT-SHAPE.
;; Walks the output with an odometer, updating each operand's offset
;; incrementally; operands of the output's own shape take a direct path.
(define (for-each-broadcast out-shape operand-shapes proc)
  (let ((n (shape-numel out-shape))
        (k (length operand-shapes)))
    (if (every (lambda (s) (equal? s out-shape)) operand-shapes)
        (do ((i 0 (+ i 1))) ((= i n)) (proc i (make-list k i)))
        (let* ((rank (length out-shape))
               (dims (list->vector out-shape))
               (strides (map (lambda (s) (list->vector (broadcast-strides s out-shape)))
                             operand-shapes))
               (idx (make-vector rank 0))
               (offs (make-vector k 0)))
          (do ((i 0 (+ i 1))) ((= i n))
            (proc i (vector->list offs))
            (let carry ((d (- rank 1)))
              (when (>= d 0)
                (vector-set! idx d (+ 1 (vector-ref idx d)))
                (for-each (lambda (st j)
                            (vector-set! offs j (+ (vector-ref offs j) (vector-ref st d))))
                          strides (iota k))
                (when (= (vector-ref idx d) (vector-ref dims d))
                  (for-each (lambda (st j)
                              (vector-set! offs j (- (vector-ref offs j)
                                                     (* (vector-ref st d) (vector-ref dims d)))))
                            strides (iota k))
                  (vector-set! idx d 0)
                  (carry (- d 1))))))))))

(define (row-major-strides shape)
  (let loop ((ds (reverse shape)) (acc 1) (out '()))
    (if (null? ds) out (loop (cdr ds) (* acc (car ds)) (cons acc out)))))

(define (unravel i shape)
  "Multi-index (list) of flat index I in SHAPE."
  (let loop ((ds (reverse shape)) (r i) (acc '()))
    (if (null? ds) acc
        (loop (cdr ds) (quotient r (car ds)) (cons (remainder r (car ds)) acc)))))

(define (ravel idx shape)
  (fold + 0 (map * idx (row-major-strides shape))))

;;; --- type rules ----------------------------------------------------------------

(define (vmap f v) (list->vector (map f (vector->list v))))

(define (numeric? dtype) (not (eq? dtype 'bool)))

(define (same-dtype op types)
  (let ((d (car (car types))))
    (unless (every (lambda (t) (eq? (car t) d)) types)
      (error "op: operand dtypes differ" op (map car types)))
    d))

(define (binary-type op result-dtype)
  (lambda (types attrs)
    (let ((d (same-dtype op types)))
      (unless (numeric? d) (error "op: numeric operands required" op d))
      (cons (or result-dtype d) (broadcast-shapes* (map cdr types))))))

(define (compare-type op)
  (lambda (types attrs)
    (same-dtype op types)
    (cons 'bool (broadcast-shapes* (map cdr types)))))

(define (logical-type op)
  (lambda (types attrs)
    (unless (eq? 'bool (same-dtype op types))
      (error "op: bool operands required" op (map car types)))
    (cons 'bool (broadcast-shapes* (map cdr types)))))

(define (unary-type op)
  (lambda (types attrs)
    (let ((d (car (car types))))
      (unless (numeric? d) (error "op: numeric operand required" op d))
      (car types))))

(define (normalize-axes axes rank)
  (map (lambda (a)
         (let ((a* (if (< a 0) (+ a rank) a)))
           (unless (and (>= a* 0) (< a* rank))
             (error "reduce_sum: axis out of range" a rank))
           a*))
       axes))

(define (reduce-shape shape attrs)
  (let* ((rank (length shape))
         (axes (normalize-axes (attr-ref attrs 'axes '()) rank))
         (axes (if (null? axes) (iota rank) axes))
         (keep (= 1 (attr-ref attrs 'keepdims 1))))
    (values axes
            (append-map (lambda (d i)
                          (cond ((not (memv i axes)) (list d))
                                (keep (list 1))
                                (else '())))
                        shape (iota rank)))))

(define (matmul-type types attrs)
  (let ((d (same-dtype 'matmul types))
        (a (cdr (car types))) (b (cdr (cadr types))))
    (unless (and (= 2 (length a)) (= 2 (length b)) (= (cadr a) (car b)))
      (error "matmul: expects [m k] x [k n]" a b))
    (cons d (list (car a) (cadr b)))))

(define (reduce-type types attrs)
  (let ((t (car types)))
    (unless (numeric? (car t)) (error "reduce_sum: numeric operand required"))
    (call-with-values (lambda () (reduce-shape (cdr t) attrs))
      (lambda (axes shape) (cons (car t) shape)))))

(define (where-type types attrs)
  (let ((c (car types)) (x (cadr types)) (y (caddr types)))
    (unless (eq? (car c) 'bool) (error "where: condition must be bool" (car c)))
    (unless (eq? (car x) (car y)) (error "where: branch dtypes differ"))
    (cons (car x) (broadcast-shapes* (map cdr types)))))

(define (permute-type types attrs)
  (let* ((t (car types)) (dims (attr-ref attrs 'dims #f)))
    (unless (and dims (equal? (sort dims <) (iota (length (cdr t)))))
      (error "permute: dims must be a permutation of the axes" dims (cdr t)))
    (cons (car t) (map (lambda (d) (list-ref (cdr t) d)) dims))))

(define (float-unary-type op)
  (lambda (types attrs)
    (let ((d (car (car types))))
      (unless (memq d '(float32 float16 bfloat16 float64))
        (error "op: float operand required" op d))
      (car types))))

(define (index-select-type types attrs)
  (let* ((t (car types)) (ix (cadr types))
         (axis (attr-ref attrs 'axis 0)))
    (unless (and (int-dtype? (car ix)) (= 1 (length (cdr ix))))
      (error "index_select: index must be a 1-D integer tensor" ix))
    (cons (car t) (append (take (cdr t) axis) (list (car (cdr ix)))
                          (drop (cdr t) (+ axis 1))))))

(define (index-add-type types attrs)
  (let* ((base (car types)) (ix (cadr types)) (src (caddr types))
         (axis (attr-ref attrs 'axis 0)))
    (unless (equal? (cdr (index-select-type (list base ix) attrs)) (cdr src))
      (error "index_add: source shape does not match" (cdr src)))
    base))

(define (gather-type types attrs)
  (let ((t (car types)) (ix (cadr types)))
    (unless (and (int-dtype? (car ix)) (= (length (cdr t)) (length (cdr ix))))
      (error "gather: index must be an integer tensor of the same rank" ix))
    (cons (car t) (cdr ix))))

(define (scatter-add-type types attrs)
  (let ((base (car types)) (ix (cadr types)) (src (caddr types)))
    (unless (and (int-dtype? (car ix)) (equal? (cdr ix) (cdr src)))
      (error "scatter_add: index and source shapes differ" ix src))
    base))

(define (concat-type types attrs)
  (let* ((axis (attr-ref attrs 'axis 0))
         (d (same-dtype 'concat types))
         (first (cdr (car types))))
    (for-each (lambda (t)
                (unless (and (= (length (cdr t)) (length first))
                             (every (lambda (a b i) (or (= i axis) (= a b)))
                                    (cdr t) first (iota (length first))))
                  (error "concat: shapes differ off the axis" (map cdr types))))
              types)
    (cons d (append (take first axis)
                    (list (fold + 0 (map (lambda (t) (list-ref (cdr t) axis)) types)))
                    (drop first (+ axis 1))))))

(define (slice-type types attrs)
  (let* ((t (car types)) (axis (attr-ref attrs 'axis 0))
         (start (attr-ref attrs 'start 0)) (end (attr-ref attrs 'end 0)))
    (unless (and (<= 0 start end (list-ref (cdr t) axis)))
      (error "slice: bad range" start end (cdr t)))
    (cons (car t) (append (take (cdr t) axis) (list (- end start))
                          (drop (cdr t) (+ axis 1))))))

(define (bmm-type types attrs)
  (let ((d (same-dtype 'bmm types))
        (a (cdr (car types))) (b (cdr (cadr types))))
    (unless (and (= 3 (length a)) (= 3 (length b)) (= (car a) (car b))
                 (= (caddr a) (cadr b)))
      (error "bmm: expects [b m k] x [b k n]" a b))
    (cons d (list (car a) (cadr a) (caddr b)))))

(define (reshape-type types attrs)
  (let ((t (car types)) (shape (attr-ref attrs 'shape #f)))
    (unless (and shape (= (shape-numel shape) (shape-numel (cdr t))))
      (error "reshape: element count differs" (cdr t) shape))
    (cons (car t) shape)))

(define (expand-type types attrs)
  (let ((t (car types)) (shape (attr-ref attrs 'shape #f)))
    (unless (and shape (equal? shape (broadcast-shapes* (list (cdr t) shape))))
      (error "expand: cannot broadcast" (cdr t) shape))
    (cons (car t) shape)))

;;; --- kernels ---------------------------------------------------------------------

(define (binary-kernel op f result-dtype)
  (lambda (ts attrs)
    (let* ((type ((binary-type op result-dtype)
                  (map (lambda (t) (cons (ctensor-dtype t) (ctensor-shape t))) ts)
                  attrs))
           (shape (cdr type))
           (n (shape-numel shape))
           (out (make-vector n))
           (a (ctensor-data (car ts))) (b (ctensor-data (cadr ts)))
           (sa (ctensor-shape (car ts))) (sb (ctensor-shape (cadr ts))))
      (cond
       ((and (equal? sa shape) (equal? sb shape))
        (do ((i 0 (+ i 1))) ((= i n))
          (vector-set! out i (f (vector-ref a i) (vector-ref b i)))))
       ((and (equal? sa shape) (= 1 (vector-length b)))
        (let ((y (vector-ref b 0)))
          (do ((i 0 (+ i 1))) ((= i n)) (vector-set! out i (f (vector-ref a i) y)))))
       ((and (equal? sb shape) (= 1 (vector-length a)))
        (let ((x (vector-ref a 0)))
          (do ((i 0 (+ i 1))) ((= i n)) (vector-set! out i (f x (vector-ref b i))))))
       (else
        (for-each-broadcast shape (list sa sb)
          (lambda (i js)
            (vector-set! out i (f (vector-ref a (car js)) (vector-ref b (cadr js))))))))
      (make-ctensor (car type) shape out))))

(define (typed-binary-kernel type-rule f)
  (lambda (ts attrs)
    (let* ((type (type-rule (map (lambda (t) (cons (ctensor-dtype t) (ctensor-shape t)))
                                 ts)
                            attrs))
           (out (make-vector (shape-numel (cdr type)))))
      (for-each-broadcast (cdr type) (map ctensor-shape ts)
        (lambda (i js)
          (vector-set! out i (apply f (map ctensor-ref ts js)))))
      (make-ctensor (car type) (cdr type) out))))

(define (same-value? a b) (if (boolean? a) (eq? a b) (= a b)))

(define (unary-kernel f)
  (lambda (ts attrs)
    (let ((t (car ts)))
      (make-ctensor (ctensor-dtype t) (ctensor-shape t)
                    (vmap f (ctensor-data t))))))

(define (relu x) (if (> x 0) x (- x x)))

(define (matmul-kernel ts attrs)
  (let* ((a (car ts)) (b (cadr ts))
         (type (matmul-type (list (cons (ctensor-dtype a) (ctensor-shape a))
                                  (cons (ctensor-dtype b) (ctensor-shape b)))
                            attrs))
         (m (car (ctensor-shape a))) (k (cadr (ctensor-shape a)))
         (n (cadr (ctensor-shape b)))
         (out (make-vector (* m n))))
    (do ((i 0 (+ i 1))) ((= i m))
      (do ((j 0 (+ j 1))) ((= j n))
        (vector-set! out (+ (* i n) j)
                     (let loop ((p 0) (acc 0))
                       (if (= p k) acc
                           (loop (+ p 1)
                                 (+ acc (* (ctensor-ref a (+ (* i k) p))
                                           (ctensor-ref b (+ (* p n) j))))))))))
    (make-ctensor (car type) (cdr type) out)))

(define (reduce-kernel ts attrs)
  (let* ((t (car ts)) (shape (ctensor-shape t)))
    (call-with-values (lambda () (reduce-shape shape attrs))
      (lambda (axes out-shape)
        ;; Output index = input multi-index with the reduced axes zeroed, mapped
        ;; through the keepdims-shaped strides.
        (let* ((kept-shape (map (lambda (d i) (if (memv i axes) 1 d))
                                shape (iota (length shape))))
               (out (make-vector (shape-numel out-shape) 0)))
          (for-each-broadcast shape (list kept-shape)
            (lambda (i js)
              (vector-set! out (car js)
                           (+ (vector-ref out (car js)) (ctensor-ref t i)))))
          (make-ctensor (ctensor-dtype t) out-shape out))))))

(define (where-kernel ts attrs)
  (let* ((type (where-type (map (lambda (t) (cons (ctensor-dtype t)
                                                  (ctensor-shape t)))
                                ts)
                           attrs))
         (out (make-vector (shape-numel (cdr type)))))
    (for-each-broadcast (cdr type) (map ctensor-shape ts)
      (lambda (i js)
        (vector-set! out i (if (ctensor-ref (car ts) (car js))
                               (ctensor-ref (cadr ts) (cadr js))
                               (ctensor-ref (caddr ts) (caddr js))))))
    (make-ctensor (car type) (cdr type) out)))

;; print: identity on the value, writes "label: nested-values" as an effect.
(define (print-kernel ts attrs)
  (let ((t (car ts)) (port (current-output-port)))
    (display (attr-ref attrs 'label "print") port)
    (display ": " port)
    (write (ctensor->nested t) port)
    (newline port)
    t))

(define (permute-kernel ts attrs)
  (let* ((t (car ts)) (shape (ctensor-shape t))
         (type (permute-type (list (cons (ctensor-dtype t) shape)) attrs))
         (dims (attr-ref attrs 'dims #f))
         (in-strides (row-major-strides shape))
         ;; source stride for each output axis
         (strides (map (lambda (d) (list-ref in-strides d)) dims))
         (out (make-vector (shape-numel shape))))
    (for-each-broadcast (cdr type) '()
      (lambda (i js)
        (vector-set! out i (ctensor-ref t (fold + 0 (map * (unravel i (cdr type)) strides))))))
    (make-ctensor (car type) (cdr type) out)))

(define (reduce-with init combine finish)
  (lambda (ts attrs)
    (let* ((t (car ts)) (shape (ctensor-shape t)))
      (call-with-values (lambda () (reduce-shape shape attrs))
        (lambda (axes out-shape)
          (let* ((kept-shape (map (lambda (d i) (if (memv i axes) 1 d))
                                  shape (iota (length shape))))
                 (count (/ (shape-numel shape) (max 1 (shape-numel out-shape))))
                 (out (make-vector (shape-numel out-shape) init)))
            (for-each-broadcast shape (list kept-shape)
              (lambda (i js)
                (vector-set! out (car js) (combine (vector-ref out (car js))
                                                   (ctensor-ref t i)))))
            (make-ctensor (ctensor-dtype t) out-shape
                          (vmap (lambda (x) (finish x count)) out))))))))

(define (gelu-tanh x)
  ;; 0.5 x (1 + tanh(sqrt(2/pi) (x + 0.044715 x^3)))
  (* 0.5 x (+ 1 (tanh (* (sqrt (/ 2 (acos -1))) (+ x (* 0.044715 x x x)))))))

(define (index-select-kernel ts attrs)
  (let* ((t (car ts)) (ix (cadr ts)) (axis (attr-ref attrs 'axis 0))
         (shape (ctensor-shape t))
         (type (index-select-type (list (cons (ctensor-dtype t) shape)
                                        (cons (ctensor-dtype ix) (ctensor-shape ix)))
                                  attrs))
         (out (make-vector (shape-numel (cdr type)))))
    (do ((i 0 (+ i 1))) ((= i (vector-length out)))
      (let ((idx (unravel i (cdr type))))
        (vector-set! out i
                     (ctensor-ref t (ravel (append (take idx axis)
                                                   (list (ctensor-ref ix (list-ref idx axis)))
                                                   (drop idx (+ axis 1)))
                                           shape)))))
    (make-ctensor (car type) (cdr type) out)))

(define (index-add-kernel ts attrs)
  (let* ((base (car ts)) (ix (cadr ts)) (src (caddr ts)) (axis (attr-ref attrs 'axis 0))
         (shape (ctensor-shape base))
         (out (vector-copy (ctensor-data base))))
    (do ((i 0 (+ i 1))) ((= i (ctensor-numel src)))
      (let* ((idx (unravel i (ctensor-shape src)))
             (j (ravel (append (take idx axis) (list (ctensor-ref ix (list-ref idx axis)))
                               (drop idx (+ axis 1)))
                       shape)))
        (vector-set! out j (+ (vector-ref out j) (ctensor-ref src i)))))
    (make-ctensor (ctensor-dtype base) shape out)))

(define (gather-kernel ts attrs)
  (let* ((t (car ts)) (ix (cadr ts)) (axis (attr-ref attrs 'axis 0))
         (shape (ctensor-shape t))
         (out (make-vector (ctensor-numel ix))))
    (do ((i 0 (+ i 1))) ((= i (vector-length out)))
      (let ((idx (unravel i (ctensor-shape ix))))
        (vector-set! out i
                     (ctensor-ref t (ravel (append (take idx axis) (list (ctensor-ref ix i))
                                                   (drop idx (+ axis 1)))
                                           shape)))))
    (make-ctensor (ctensor-dtype t) (ctensor-shape ix) out)))

(define (scatter-add-kernel ts attrs)
  (let* ((base (car ts)) (ix (cadr ts)) (src (caddr ts)) (axis (attr-ref attrs 'axis 0))
         (shape (ctensor-shape base))
         (out (vector-copy (ctensor-data base))))
    (do ((i 0 (+ i 1))) ((= i (ctensor-numel src)))
      (let* ((idx (unravel i (ctensor-shape src)))
             (j (ravel (append (take idx axis) (list (ctensor-ref ix i)) (drop idx (+ axis 1)))
                       shape)))
        (vector-set! out j (+ (vector-ref out j) (ctensor-ref src i)))))
    (make-ctensor (ctensor-dtype base) shape out)))

(define (concat-kernel ts attrs)
  (let* ((axis (attr-ref attrs 'axis 0))
         (type (concat-type (map (lambda (t) (cons (ctensor-dtype t) (ctensor-shape t))) ts)
                            attrs))
         (out (make-vector (shape-numel (cdr type)))))
    (let loop ((ts ts) (offset 0))
      (unless (null? ts)
        (let* ((t (car ts)) (shape (ctensor-shape t)))
          (do ((i 0 (+ i 1))) ((= i (ctensor-numel t)))
            (let ((idx (unravel i shape)))
              (vector-set! out (ravel (append (take idx axis)
                                              (list (+ offset (list-ref idx axis)))
                                              (drop idx (+ axis 1)))
                                      (cdr type))
                           (ctensor-ref t i))))
          (loop (cdr ts) (+ offset (list-ref shape axis))))))
    (make-ctensor (car type) (cdr type) out)))

(define (slice-kernel ts attrs)
  (let* ((t (car ts)) (axis (attr-ref attrs 'axis 0)) (start (attr-ref attrs 'start 0))
         (type (slice-type (list (cons (ctensor-dtype t) (ctensor-shape t))) attrs))
         (out (make-vector (shape-numel (cdr type)))))
    (do ((i 0 (+ i 1))) ((= i (vector-length out)))
      (let ((idx (unravel i (cdr type))))
        (vector-set! out i
                     (ctensor-ref t (ravel (append (take idx axis)
                                                   (list (+ start (list-ref idx axis)))
                                                   (drop idx (+ axis 1)))
                                           (ctensor-shape t))))))
    (make-ctensor (car type) (cdr type) out)))

(define (bmm-kernel ts attrs)
  (let* ((a (car ts)) (b (cadr ts))
         (type (bmm-type (list (cons (ctensor-dtype a) (ctensor-shape a))
                               (cons (ctensor-dtype b) (ctensor-shape b)))
                         attrs))
         (bs (car (ctensor-shape a))) (m (cadr (ctensor-shape a)))
         (k (caddr (ctensor-shape a))) (n (caddr (ctensor-shape b)))
         (out (make-vector (* bs m n))))
    (do ((q 0 (+ q 1))) ((= q bs))
      (do ((i 0 (+ i 1))) ((= i m))
        (do ((j 0 (+ j 1))) ((= j n))
          (vector-set! out (+ (* q m n) (* i n) j)
                       (let loop ((p 0) (acc 0))
                         (if (= p k) acc
                             (loop (+ p 1)
                                   (+ acc (* (ctensor-ref a (+ (* q m k) (* i k) p))
                                             (ctensor-ref b (+ (* q k n) (* p n) j)))))))))))
    (make-ctensor (car type) (cdr type) out)))

(define (reshape-kernel ts attrs)
  (let ((t (car ts)))
    (make-ctensor (ctensor-dtype t) (attr-ref attrs 'shape #f) (ctensor-data t))))

(define (expand-kernel ts attrs)
  (let* ((t (car ts)) (shape (attr-ref attrs 'shape #f))
         (out (make-vector (shape-numel shape))))
    (for-each-broadcast shape (list (ctensor-shape t))
      (lambda (i js) (vector-set! out i (ctensor-ref t (car js)))))
    (make-ctensor (ctensor-dtype t) shape out)))

;;; --- gradients ----------------------------------------------------------------------
;;; A gradient rule is a pure function
;;;   (rule emit shape ins out g attrs) -> list of input gradients (#f = none)
;;; INS / OUT are the forward input and output values, G the gradient of OUT.
;;; EMIT is (emit op args attrs) -> value: it creates the backward node (args
;;; may be Scheme numbers, lifted to constants). SHAPE gives a value's shape.
;;; Rules of elementwise ops return input gradients at the OUTPUT shape; the
;;; autodiff engine masks them (double where) and then reduces them to the
;;; input shape with sum-to-shape. Other rules return input-shaped gradients.

(define (ints . xs) `(ints ,@xs))

(define (sum-to-shape emit shape g target)
  "Reduce G (broadcast result) to shape TARGET: sum the leading axes and the
axes TARGET has as 1, then reshape."
  (let* ((gs (shape g))
         (lead (- (length gs) (length target))))
    (if (equal? gs target)
        g
        (let ((axes (filter (lambda (i)
                              (or (< i lead)
                                  (and (= 1 (list-ref target (- i lead)))
                                       (not (= 1 (list-ref gs i))))))
                            (iota (length gs)))))
          (emit 'reshape
                (list (emit 'reduce_sum (list g)
                            `((axes ,(apply ints axes)) (keepdims (int 1)))))
                `((shape ,(apply ints target))))))))

(define (grad-add e shape ins out g attrs) (list g g))
(define (grad-sub e shape ins out g attrs) (list g (e 'neg (list g) '())))
(define (grad-mul e shape ins out g attrs)
  (list (e 'mul (list g (cadr ins)) '()) (e 'mul (list g (car ins)) '())))
(define (grad-div e shape ins out g attrs)
  (let ((a (car ins)) (b (cadr ins)))
    (list (e 'div (list g b) '())
          (e 'neg (list (e 'div (list (e 'mul (list g a) '())
                                      (e 'mul (list b b) '()))
                           '()))
             '()))))
(define (grad-neg e shape ins out g attrs) (list (e 'neg (list g) '())))
(define (grad-relu e shape ins out g attrs)
  (list (e 'where (list (e 'greater (list (car ins) 0) '()) g 0) '())))
(define (grad-where e shape ins out g attrs)
  (let ((c (car ins)))
    (list #f (e 'where (list c g 0) '()) (e 'where (list c 0 g) '()))))
(define (grad-identity e shape ins out g attrs) (list g))
(define (grad-matmul e shape ins out g attrs)
  (let ((a (car ins)) (b (cadr ins)))
    (list (e 'matmul (list g (e 'permute (list b) '((dims (ints 1 0))))) '())
          (e 'matmul (list (e 'permute (list a) '((dims (ints 1 0)))) g) '()))))
(define (inverse-permutation dims)
  (map (lambda (i) (list-index (lambda (d) (= d i)) dims)) (iota (length dims))))
(define (grad-permute e shape ins out g attrs)
  (list (e 'permute (list g) `((dims ,(apply ints (inverse-permutation
                                                     (attr-ref attrs 'dims #f))))))))
(define (swap-last2 x shape)
  (let ((r (length (shape x))))
    `((dims ,(apply ints (append (iota (- r 2)) (list (- r 1) (- r 2))))))))
(define (zeros-like-shape dtype shp)
  (make-ctensor dtype shp (make-list (shape-numel shp) 0)))

(define (grad-exp e shape ins out g attrs) (list (e 'mul (list g out) '())))
(define (grad-log e shape ins out g attrs) (list (e 'div (list g (car ins)) '())))
(define (grad-tanh e shape ins out g attrs)
  (list (e 'mul (list g (e 'sub (list 1 (e 'mul (list out out) '())) '())) '())))
(define (grad-sqrt e shape ins out g attrs)
  (list (e 'div (list g (e 'mul (list out 2) '())) '())))
(define (grad-gelu e shape ins out g attrs)
  ;; d/dx 0.5x(1+t), t = tanh(c(x + a x^3)):  0.5(1+t) + 0.5x(1-t^2) c(1 + 3a x^2)
  (let* ((x (car ins)) (a 0.044715) (c (sqrt (/ 2 (acos -1))))
         (x2 (e 'mul (list x x) '()))
         (u (e 'mul (list (e 'add (list x (e 'mul (list (e 'mul (list x2 x) '()) a) '())) '())
                          c) '()))
         (t (e 'tanh (list u) '()))
         (left (e 'mul (list (e 'add (list t 1) '()) 0.5) '()))
         (right (e 'mul (list (e 'mul (list x (e 'sub (list 1 (e 'mul (list t t) '())) '())) '())
                              (e 'mul (list (e 'add (list (e 'mul (list x2 (* 3 a)) '()) 1) '())
                                            (* 0.5 c)) '()))
                   '())))
    (list (e 'mul (list g (e 'add (list left right) '())) '()))))
(define (kept-shape-of in-shape attrs)
  (let* ((rank (length in-shape))
         (axes (normalize-axes (attr-ref attrs 'axes '()) rank))
         (axes (if (null? axes) (iota rank) axes)))
    (values axes (map (lambda (d i) (if (memv i axes) 1 d)) in-shape (iota rank)))))
(define (grad-reduce-mean e shape ins out g attrs)
  (let ((in-shape (shape (car ins))))
    (call-with-values (lambda () (kept-shape-of in-shape attrs))
      (lambda (axes kept)
        (let ((count (fold * 1 (map (lambda (i) (list-ref in-shape i)) axes))))
          (list (e 'mul (list (e 'expand (list (e 'reshape (list g) `((shape ,(apply ints kept)))))
                                 `((shape ,(apply ints in-shape))))
                              (/ 1.0 count))
                   '())))))))
(define (grad-reduce-max e shape ins out g attrs)
  ;; the gradient goes to the positions equal to the max (ties each get it)
  (let ((x (car ins)) (in-shape (shape (car ins))))
    (call-with-values (lambda () (kept-shape-of in-shape attrs))
      (lambda (axes kept)
        (let ((spread (lambda (v) (e 'expand (list (e 'reshape (list v) `((shape ,(apply ints kept)))))
                                     `((shape ,(apply ints in-shape)))))))
          (list (e 'where (list (e 'equal (list x (spread out)) '()) (spread g) 0) '())))))))
(define (grad-index-select e shape ins out g attrs)
  (let ((t (car ins)))
    (list (e 'index_add (list (zeros-like-shape (sym-or-dtype t) (shape t)) (cadr ins) g) attrs)
          #f)))
(define (grad-index-add e shape ins out g attrs)
  (list g #f (e 'index_select (list g (cadr ins)) attrs)))
(define (grad-gather e shape ins out g attrs)
  (let ((t (car ins)))
    (list (e 'scatter_add (list (zeros-like-shape (sym-or-dtype t) (shape t)) (cadr ins) g) attrs)
          #f)))
(define (grad-scatter-add e shape ins out g attrs)
  (list g #f (e 'gather (list g (cadr ins)) attrs)))
(define (grad-concat e shape ins out g attrs)
  (let ((axis (attr-ref attrs 'axis 0)))
    (let loop ((ins ins) (start 0) (acc '()))
      (if (null? ins)
          (reverse acc)
          (let ((len (list-ref (shape (car ins)) axis)))
            (loop (cdr ins) (+ start len)
                  (cons (e 'slice (list g) `((axis (int ,axis)) (start (int ,start))
                                             (end (int ,(+ start len)))))
                        acc)))))))
(define (grad-slice e shape ins out g attrs)
  ;; pad the gradient with zeros back to the input's extent along the axis
  (let* ((x (car ins)) (in-shape (shape x)) (axis (attr-ref attrs 'axis 0))
         (start (attr-ref attrs 'start 0)) (end (attr-ref attrs 'end 0))
         (block (lambda (len) (zeros-like-shape (sym-or-dtype x)
                                                (append (take in-shape axis) (list len)
                                                        (drop in-shape (+ axis 1))))))
         (parts (append (if (> start 0) (list (block start)) '())
                        (list g)
                        (let ((rest (- (list-ref in-shape axis) end)))
                          (if (> rest 0) (list (block rest)) '())))))
    (list (if (null? (cdr parts)) g (e 'concat parts `((axis (int ,axis))))))))
(define (grad-bmm e shape ins out g attrs)
  (let ((a (car ins)) (b (cadr ins)))
    (list (e 'bmm (list g (e 'permute (list b) (swap-last2 b shape))) '())
          (e 'bmm (list (e 'permute (list a) (swap-last2 a shape)) g) '()))))
(define (grad-reshape e shape ins out g attrs)
  (list (e 'reshape (list g) `((shape ,(apply ints (shape (car ins))))))))
(define (grad-expand e shape ins out g attrs)
  (list (sum-to-shape e shape g (shape (car ins)))))
(define (grad-reduce-sum e shape ins out g attrs)
  (let* ((in-shape (shape (car ins)))
         (rank (length in-shape))
         (axes (normalize-axes (attr-ref attrs 'axes '()) rank))
         (axes (if (null? axes) (iota rank) axes))
         (kept (map (lambda (d i) (if (memv i axes) 1 d)) in-shape (iota rank))))
    (list (e 'expand (list (e 'reshape (list g) `((shape ,(apply ints kept)))))
             `((shape ,(apply ints in-shape)))))))
(define (no-grad e shape ins out g attrs) (map (lambda (x) #f) ins))

;; Gradient rules see forward values through SHAPE only; the dtype of a zero
;; block is taken from the value when it is a ctensor, else float32 (the
;; prototype differentiates float32 graphs).
(define (sym-or-dtype x) (if (ctensor? x) (ctensor-dtype x) 'float32))

;;; --- table ------------------------------------------------------------------------

;; name -> (arity type-rule kernel aten-name gradient-rule elementwise?)
;; ATen names are PyTorch Core ATen IR operators (design doc, op table).
(define %ops
  `((add       2 ,(binary-type 'add #f) ,(binary-kernel 'add + #f)
               "aten::add.Tensor" ,grad-add #t)
    (sub       2 ,(binary-type 'sub #f) ,(binary-kernel 'sub - #f)
               "aten::sub.Tensor" ,grad-sub #t)
    (mul       2 ,(binary-type 'mul #f) ,(binary-kernel 'mul * #f)
               "aten::mul.Tensor" ,grad-mul #t)
    (div       2 ,(binary-type 'div #f) ,(binary-kernel 'div / #f)
               "aten::div.Tensor" ,grad-div #t)
    (greater   2 ,(binary-type 'greater 'bool) ,(binary-kernel 'greater > 'bool)
               "aten::gt.Tensor" ,no-grad #f)
    (less      2 ,(binary-type 'less 'bool) ,(binary-kernel 'less < 'bool)
               "aten::lt.Tensor" ,no-grad #f)
    (equal     2 ,(compare-type 'equal)
               ,(typed-binary-kernel (compare-type 'equal) same-value?)
               "aten::eq.Tensor" ,no-grad #f)
    (and       2 ,(logical-type 'and)
               ,(typed-binary-kernel (logical-type 'and) (lambda (a b) (and a b)))
               "aten::logical_and" ,no-grad #f)
    (or        2 ,(logical-type 'or)
               ,(typed-binary-kernel (logical-type 'or) (lambda (a b) (or a b)))
               "aten::logical_or" ,no-grad #f)
    (not       1 ,(logical-type 'not) ,(typed-binary-kernel (logical-type 'not) not)
               "aten::logical_not" ,no-grad #f)
    (matmul    2 ,matmul-type ,matmul-kernel "aten::mm" ,grad-matmul #f)
    (permute   1 ,permute-type ,permute-kernel "aten::permute" ,grad-permute #f)
    (bmm       2 ,bmm-type ,bmm-kernel "aten::bmm" ,grad-bmm #f)
    (exp       1 ,(float-unary-type 'exp) ,(unary-kernel exp) "aten::exp" ,grad-exp #t)
    (log       1 ,(float-unary-type 'log) ,(unary-kernel log) "aten::log" ,grad-log #t)
    (tanh      1 ,(float-unary-type 'tanh) ,(unary-kernel tanh) "aten::tanh" ,grad-tanh #t)
    (sqrt      1 ,(float-unary-type 'sqrt) ,(unary-kernel sqrt) "aten::sqrt" ,grad-sqrt #t)
    (gelu      1 ,(float-unary-type 'gelu) ,(unary-kernel gelu-tanh) "aten::gelu"
               ,grad-gelu #t)
    (reduce_max 1 ,reduce-type ,(reduce-with -inf.0 max (lambda (x n) x)) "aten::amax"
               ,grad-reduce-max #f)
    (reduce_mean 1 ,reduce-type ,(reduce-with 0 + (lambda (x n) (/ x n))) "aten::mean.dim"
               ,grad-reduce-mean #f)
    (index_select 2 ,index-select-type ,index-select-kernel "aten::index_select"
               ,grad-index-select #f)
    (index_add 3 ,index-add-type ,index-add-kernel "aten::index_add" ,grad-index-add #f)
    (gather    2 ,gather-type ,gather-kernel "aten::gather" ,grad-gather #f)
    (scatter_add 3 ,scatter-add-type ,scatter-add-kernel "aten::scatter_add"
               ,grad-scatter-add #f)
    (concat    n ,concat-type ,concat-kernel "aten::cat" ,grad-concat #f)
    (slice     1 ,slice-type ,slice-kernel "aten::slice.Tensor" ,grad-slice #f)
    (reshape   1 ,reshape-type ,reshape-kernel "aten::view" ,grad-reshape #f)
    (expand    1 ,expand-type ,expand-kernel "aten::expand" ,grad-expand #f)
    (relu      1 ,(unary-type 'relu) ,(unary-kernel relu) "aten::relu" ,grad-relu #t)
    (neg       1 ,(unary-type 'neg) ,(unary-kernel -) "aten::neg" ,grad-neg #t)
    (reduce_sum 1 ,reduce-type ,reduce-kernel "aten::sum.dim_IntList"
               ,grad-reduce-sum #f)
    (where     3 ,where-type ,where-kernel "aten::where.self" ,grad-where #t)
    (print     1 ,(lambda (types attrs) (car types)) ,print-kernel
               #f ,grad-identity #t)))

;; Ops whose kernel has an effect: always recorded while tracing and never
;; removed by DCE.
(define %effectful-ops '(print))
(define (op-effectful? op) (and (memq op %effectful-ops) #t))

(define (entry op)
  (or (assq-ref %ops op) (error "unsupported op" op)))

(define (op-known? op) (and (assq op %ops) #t))
(define (op-arity op) (car (entry op)))

(define (check-arity op n)
  (unless (or (eq? 'n (op-arity op)) (= n (op-arity op)))
    (error "op: wrong number of inputs" op n)))

(define (op-type op types attrs)
  (check-arity op (length types))
  ((cadr (entry op)) types attrs))

(define (op-kernel op tensors attrs)
  (check-arity op (length tensors))
  ((caddr (entry op)) tensors attrs))

(define (op-aten-name op) (and (op-known? op) (list-ref (entry op) 3)))
(define (op-gradient op) (and (op-known? op) (list-ref (entry op) 4)))
(define (op-elementwise? op) (and (op-known? op) (list-ref (entry op) 5)))
